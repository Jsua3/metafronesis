    {
      "key": "valorar-el-riesgo",
      "label": "Valorar el riesgo",
      "description": "Explorar con la persona usuaria las señales de riesgo y estimar su nivel antes de decidir el acompañamiento. [por validar con Psicología]",
      "decisive": true
    },
    {
      "key": "informar-derechos",
      "label": "Informar derechos",
      "description": "Explicar a la persona usuaria sus derechos y las rutas de atención que existen en la universidad y en la ciudad. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "recomendar-medidas-de-proteccion",
      "label": "Recomendar medidas de protección",
      "description": "Proponer medidas concretas de protección y acompañar a la persona a solicitarlas. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "derivar-a-salud-mental",
      "label": "Derivar a salud mental",
      "description": "Remitir a la persona usuaria a atención en salud mental y asegurar que la remisión llegue. [por validar con Psicología]",
      "decisive": true
    },
    {
      "key": "aplicar-primeros-auxilios-psicologicos",
      "label": "Aplicar primeros auxilios psicológicos",
      "description": "Escuchar, proteger y conectar a la persona en crisis antes de cualquier otro paso. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "no-mediar-con-el-agresor",
      "label": "No mediar con el agresor",
      "description": "Evitar cualquier mediación o careo entre la persona usuaria y quien la agrede. [por validar con Psicología]",
      "decisive": false
    }
  ],
