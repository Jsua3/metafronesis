{
  "esquema": 2,
  "id": "casa",
  "nombre": "Casa",
  "descripcion": "Casa de barrio: sala, comedor, cocina, patio y las habitaciones del segundo piso. Visita domiciliaria y acompañamiento a la persona usuaria y a niñas, niños y adolescentes.",
  "temas": [
    "violencia-genero",
    "ninez-adolescencia",
    "plan-seguridad"
  ],
  "completo": true,
  "arteProvisional": true,
  "nivelRiesgoPorDefecto": "SEVERE",
  "hitos": [
    {
      "key": "valorar-el-riesgo",
      "label": "Valorar el riesgo",
      "description": "Explorar con la persona usuaria las señales de riesgo en la casa y estimar su nivel antes de decidir el acompañamiento. [por validar con Psicología]",
      "decisive": true
    },
    {
      "key": "informar-derechos",
      "label": "Informar derechos",
      "description": "Explicar a la persona usuaria sus derechos y las rutas de atención que existen en el barrio y en la ciudad. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "recomendar-medidas-de-proteccion",
      "label": "Recomendar medidas de protección",
      "description": "Proponer medidas concretas de protección y acompañar a la persona a solicitarlas en la comisaría de familia. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "derivar-a-salud-mental",
      "label": "Derivar a salud mental",
      "description": "Remitir a la persona usuaria a atención en salud mental y asegurar que la remisión llegue. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "aplicar-primeros-auxilios-psicologicos",
      "label": "Aplicar primeros auxilios psicológicos",
      "description": "Escuchar, proteger y conectar a la persona en crisis antes de cualquier otro paso. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "no-mediar-con-el-agresor",
      "label": "No mediar con el agresor",
      "description": "Evitar cualquier mediación o careo entre la persona usuaria y quien la agrede, también dentro de la casa. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "identificar-una-red-de-apoyo",
      "label": "Identificar una red de apoyo",
      "description": "Reconocer con la persona usuaria a quién puede acudir: familiares, vecinas, amistades, instituciones. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "acordar-un-plan-de-seguridad",
      "label": "Acordar un plan de seguridad",
      "description": "Acordar con la persona usuaria qué hace, a quién llama y a dónde va si el riesgo sube. [por validar con Psicología]",
      "decisive": true
    }
  ],
