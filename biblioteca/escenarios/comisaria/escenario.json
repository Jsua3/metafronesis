{
  "esquema": 2,
  "id": "comisaria",
  "nombre": "Comisaría de familia",
  "descripcion": "Comisaría de familia: recepción, sala de espera, orientación jurídica, despacho, consultorio psicosocial, sala de entrevista a niñas, niños y adolescentes, archivo y pasillo. Rutas de protección y medidas.",
  "temas": [
    "violencia-genero",
    "ninez-adolescencia",
    "rutas-proteccion"
  ],
  "completo": true,
  "arteProvisional": true,
  "nivelRiesgoPorDefecto": "EXTREME",
  "hitos": [
    {
      "key": "valorar-el-riesgo",
      "label": "Valorar el riesgo",
      "description": "Explorar con la persona usuaria las señales de riesgo y estimar su nivel con la escala del protocolo antes de decidir. [por validar con Psicología]",
      "decisive": true
    },
    {
      "key": "informar-derechos",
      "label": "Informar derechos",
      "description": "Explicar a la persona usuaria sus derechos (Ley 1257 de 2008) y lo que la comisaría puede hacer por ella. [por validar con Psicología]",
      "decisive": true
    },
    {
      "key": "recomendar-medidas-de-proteccion",
      "label": "Recomendar medidas de protección",
      "description": "Proponer las medidas de protección que correspondan y explicar cómo se piden. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "derivar-a-salud-mental",
      "label": "Derivar a salud mental",
      "description": "Remitir a la persona usuaria a atención en salud mental y asegurar que la remisión llegue. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "aplicar-primeros-auxilios-psicologicos",
      "label": "Aplicar primeros auxilios psicológicos",
      "description": "Escuchar, proteger y conectar a la persona en crisis antes de cualquier otro paso. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "no-mediar-con-el-agresor",
      "label": "No mediar con el agresor",
      "description": "Evitar cualquier mediación, conciliación o careo entre la persona usuaria y quien la agrede. [por validar con Psicología]",
      "decisive": false
    },
    {
      "key": "solicitar-medida-de-proteccion",
      "label": "Solicitar medida de protección",
      "description": "Acompañar a la persona usuaria a solicitar formalmente la medida de protección ante la comisaria. [por validar con Psicología]",
      "decisive": true
    },
    {
      "key": "registrar-la-atencion",
      "label": "Registrar la atención",
      "description": "Dejar constancia escrita de la atención, las remisiones y los acuerdos. [por validar con Psicología]",
      "decisive": false
    }
  ],
