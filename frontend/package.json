{
  "name": "psychosim-admin-panel",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build && node scripts/ui/check-dist-dev-only.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "ui:lint": "node scripts/ui/ui-lint.mjs",
    "test:ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/ui/*.test.mjs\""
  },
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/aria": "^22.2.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@dagrejs/dagre": "^1.1.8",
    "konva": "^10.9.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
