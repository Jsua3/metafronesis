# Variables de entorno del backend Django.
# Producción (DJANGO_SETTINGS_MODULE=psychosim.settings.production) las EXIGE y
# rechaza los defaults dev. En desarrollo (settings.local) hay fallbacks en base.py,
# así que en local normalmente NO necesitas un .env (los fallbacks apuntan a la BD docker).

# PLANTILLA: producción rechaza estos valores de ejemplo; genera uno propio (por ejemplo
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`). S5-1: ≥ 50 caracteres, ≥ 20 distintos.
DJANGO_SECRET_KEY=cambia-esto-en-produccion
# DJANGO_SETTINGS_MODULE: módulo de configuración que Django carga. En producción usa .production; en local, .local.
DJANGO_SETTINGS_MODULE=psychosim.settings.production
DJANGO_ALLOWED_HOSTS=tu-dominio.edu.co,localhost
CORS_ALLOWED_ORIGINS=https://tu-dominio.edu.co
# S1-1 · Proxies de confianza delante de Django: cuántos saltos añaden su dirección a X-Forwarded-For.
# Obligatoria en producción, sin valor por defecto. 0 = no se confía en la cabecera (la IP es REMOTE_ADDR).
# Railway pone uno, pero se MIDE en el primer despliegue: una petición con un X-Forwarded-For falso debe
# registrar en la auditoría la IP real, no la que escribió el cliente. En Railway, 0 no arranca: siempre hay un proxy
# delante (R1b).
SIEP_TRUSTED_PROXIES=1

DB_NAME=psychosim
DB_USER=psychosim
DB_PASSWORD=cambia-esto-por-un-secreto-fuerte
DB_HOST=localhost
DB_PORT=5433

# JWT_SECRET: obsoleto, ya no se usa (no firma nada ni lo exige producción).
# JWT_SIGNING_KEY: llave que FIRMA los tokens de sesión (S5-3). OBLIGATORIA en producción: ≥ 50 caracteres, ≥ 20 distintos,
# distinta de DJANGO_SECRET_KEY, de REFLECTION_ENCRYPTION_KEY y de cada secreto de REFLECTION_KEYS, sin valores de ejemplo.
# Genérala con `python -c "import secrets; print(secrets.token_urlsafe(48))"` y guárdala en el panel de variables de la
# plataforma, nunca en este archivo. Sin ella, el desarrollo firma con DJANGO_SECRET_KEY. Rotarla cierra todas las
# sesiones: ver docs/operacion/rotacion-de-secretos.md.
# JWT_SIGNING_KEY=
JWT_EXPIRATION_HOURS=8
# S1-4 · Sesión revocable: cada token lleva la época de sesión de su dueño. Cerrar sesión, cambiar la contraseña,
# desactivar o reactivar la cuenta y cambiar el rol dejan sin valor los tokens anteriores. Encendida por defecto;
# SIEP_SESSION_EPOCH_ENFORCE=false es solo un interruptor de emergencia (deja vivos los tokens ya emitidos). Solo
# 0/false/no/off la apagan (R1b).
# SIEP_SESSION_EPOCH_ENFORCE=true
GOOGLE_OAUTH_CLIENT_ID=tu-client-id-web-de-google.apps.googleusercontent.com
# OBLIGATORIA en producción (S5-1): ≥ 32 caracteres, ≥ 20 distintos, distinta de DJANGO_SECRET_KEY y de
# JWT_SIGNING_KEY. Cifra las bitácoras de reflexión: su confidencialidad depende de que sea fuerte y privada.
# PLANTILLA: producción rechaza este valor de ejemplo; genera uno propio.
REFLECTION_ENCRYPTION_KEY=cambia-esto-por-un-secreto-fuerte
# E2-9 · La importación de estudiantes ya no usa una contraseña compartida: las cuentas nuevas
# quedan pendientes y el ADMIN las aprueba (la contraseña temporal sale por correo). Límites
# opcionales de la importación (valores por defecto entre paréntesis):
# SIEP_IMPORT_MAX_BYTES (2 MB) · SIEP_IMPORT_MAX_UNCOMPRESSED_BYTES (8 MB) · SIEP_IMPORT_MAX_ROWS (1000)
# SIEP_IMPORT_MAX_COLUMNS (32) · SIEP_IMPORT_MAX_SECONDS (5)
# Las cuentas importadas ANTES de E2-9 conservan la contraseña compartida de entonces: corre una
# vez, antes de abrir tráfico, `python manage.py force_password_change_for_shared_passwords`
# (con --dry-run para ver cuántas marcaría).

# ── Correo transaccional (E2-12) ──────────────────────────────────────────────────
# Lleva el aviso de solicitudes de acceso, las invitaciones a grupos y la contraseña temporal
# de las cuentas aprobadas. En desarrollo sale por la consola; en PRODUCCIÓN se exige un
# backend real (o declarar SIEP_ALLOW_CONSOLE_EMAIL=true: la consola escribe esa contraseña en
# el registro) y un destino para el aviso (o ACCESS_REQUEST_NOTIFY_DISABLED=true).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tu-institucion.edu.co
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=siep@tu-institucion.edu.co
# ACCESS_REQUEST_NOTIFY_EMAILS=admin@tu-institucion.edu.co,psicologia@tu-institucion.edu.co

# ── Retención de datos personales (S3-4: RNF-003) ─────────────────────────────────
# SIEP_RETENTION_ACCESS_REQUEST_DAYS: días que se conservan las solicitudes de acceso YA RESUELTAS antes de que
# `python manage.py purge_expired_data` las borre. Entero ≥ 0; vacía o 0 = no se borra ninguna (el plazo lo define la
# institución, SD-9, y este repositorio no inventa obligaciones legales). Una solicitud pendiente nunca se borra.
# Un valor inválido impide arrancar. Los demás derechos del titular (exportar y suprimir) son comandos, sin variables:
# docs/seguridad/derechos-del-titular.md
# SIEP_RETENTION_ACCESS_REQUEST_DAYS=0

# ── Banderas del contrato expand → migrate → contract (E2) ────────────────────────
# Encendidas por defecto desde F9-10 (el cliente ya migró); `=false` las apaga como interruptor de emergencia.
# SIEP_REVIEW_WORKFLOW_STRICT=true    # publicar solo desde IN_REVIEW, con la constancia (E2-5)
# SIEP_REVISION_REQUIRED=true         # `revision` obligatoria en toda mutación de autoría (E2-6)
# Apagadas por defecto hasta que el juego migre (F10-9); el puente de invitaciones se queda hasta F10-8.
# SIEP_ATTEMPT_START_STRICT=false     # con un intento abierto, `forceNew` del estudiante → 409 (E1-1)
# SIEP_INVITATIONS_AUTO_ACCEPT=false  # PUENTE: invitar une al grupo sin aceptación ni correo (E2-10)
# SIEP_INVITATION_EMAIL_LIMIT=25      # avisos de invitación que salen de UNA importación

# ── Analítica de aprendizaje (E6; definiciones en BORRADOR de Psicología) ──────────
# Se leen al ARRANCAR el proceso: cambiarlas exige reiniciar. Una inválida cae al valor por defecto.
# SIEP_ACCEPTABLE_LEVEL=LOGRADO          # nivel desde el que un desempeño es «Aceptable» (EN_INICIO|EN_PROCESO|LOGRADO|DESTACADO)
# SIEP_MIN_CELL_SIZE=5                   # celda mínima de los agregados; NUNCA baja de 5 (piso de privacidad)
# SIEP_REFLECTION_DEFINITION=ANY         # qué cuenta como reflexión al cerrar: ANY | PER_DECISION_SCENE
# SIEP_ATTEMPT_FEEDBACK_SURVEY=false     # encuesta breve opcional al terminar un intento (apagada hasta que Psicología la apruebe)

# ── Consentimiento al aviso de contenido sensible (S3-2: ETH-01, SIEP-RF-05, RNF-010) ─────────────────────────────
# SIEP_CONTENT_NOTICE_VERSION: la versión VIGENTE del aviso (BORRADOR hasta que Psicología apruebe el texto). El servidor es
# su dueño: el cliente envía la que mostró y, si no coincide, 409 NOTICE_VERSION_STALE con la vigente. Un texto de 1 a 40
# caracteres sin espacios; vacía o con espacios detiene el arranque. Cambiarla hace que todas las personas acepten de nuevo
# (las aceptaciones viejas se conservan como evidencia). El cliente repite el valor (consent-recorder.ts; una prueba de
# contrato compara los dos): cambiarla exige cambiar a la vez el texto del aviso, esa constante y este valor por defecto, o
# todas las personas recibirían 409 NOTICE_VERSION_STALE.
# SIEP_CONTENT_NOTICE_VERSION=2026-10-borrador
# SIEP_CONSENT_REQUIRED: el cliente ya usa el servidor (S3-2b), pero sigue APAGADA hasta desplegarlo, medir su costo y recibir
# el texto aprobado. Encendida, cargar el mundo del intento y las
# órdenes de juego responden 403 CONSENT_REQUIRED sin un consentimiento vigente de ese caso; la pausa, la salida segura,
# reanudar, abandonar y consultar el intento abierto NUNCA lo exigen. Apagada, nada cambia.
# SIEP_CONSENT_REQUIRED=false
# Autorización de tratamiento de datos (sin caso): APAGADA y sin versión hasta que la institución entregue el texto (SD-8).
# Encender la bandera exige SIEP_DATA_TREATMENT_NOTICE_VERSION (mismo formato que la del aviso de contenido).
# SIEP_DATA_TREATMENT_CONSENT_REQUIRED=false
# SIEP_DATA_TREATMENT_NOTICE_VERSION=

# ── AI Assistant (RF-027) ─────────────────────────────────────────────────────
# Apagado por defecto: sin AI_ASSISTANT_ENABLED=true la ruta responde 404 aunque haya clave.
# No lo actives sin concepto jurídico escrito (Ley 1581/2012): envía texto del estudiante a un proveedor externo.
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_PROVIDER=openai
AI_ASSISTANT_API_KEY=cambia-esto-por-tu-clave-de-openai
AI_ASSISTANT_MODEL=gpt-4o-mini
