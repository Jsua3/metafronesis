{
  "$ref": "#/$defs/estructura",
  "$defs": {
    "estructura": {
      "type": "object",
      "description": "La sala armada por piezas (x-siep 2.2, contrato `.superpowers/contratos/x-siep-2.2.md`, sección 2). Que el ancho, los acabados y los modelos existan en el catálogo lo juzga la regla OCL-18; dónde va cada pieza, OCL-13 y OCL-14.",
      "required": [
        "ancho",
        "momento",
        "acabados",
        "piezas"
      ],
      "additionalProperties": false,
      "properties": {
        "ancho": {
          "enum": [
            960,
            1200,
            1440,
            1680,
            1920
          ]
        },
        "momento": {
          "enum": [
            "dia",
            "noche"
          ]
        },
        "acabados": {
          "type": "object",
          "required": [
            "piso",
            "muro",
            "paleta"
          ],
          "additionalProperties": false,
          "properties": {
            "piso": {
              "$ref": "#/$defs/claveDeCatalogo"
            },
            "variante": {
              "$ref": "#/$defs/claveDeCatalogo"
            },
            "muro": {
              "$ref": "#/$defs/claveDeCatalogo"
            },
            "paleta": {
              "$ref": "#/$defs/claveDeCatalogo"
            }
          }
        },
        "piezas": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/piezaDeSala"
          }
        },
        "exterior": {
          "type": "boolean"
        },
        "tapetes": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "ruta",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "ruta": {
                "type": "string",
                "pattern": "^piezas/tapetes/[a-z0-9]+(-[a-z0-9]+)*\\.png(?![\\s\\S])"
              },
              "x": {
                "$ref": "#/$defs/entero"
              },
              "y": {
                "$ref": "#/$defs/entero"
              },
              "caja": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/entero"
                }
              },
              "colores": {
                "type": "object",
                "maxProperties": 12,
                "additionalProperties": {
                  "$ref": "#/$defs/color"
                }
              }
            }
          }
        },
        "propios": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "ruta"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "maxLength": 120
              },
              "ruta": {
                "type": "string",
                "pattern": "^piezas/propios/[a-z0-9]+(-[a-z0-9]+)*\\.png(?![\\s\\S])"
              }
            }
          }
        }
      }
    },
    "piezaDeSala": {
      "type": "object",
      "description": "Una pieza de muro (`muro`, `pos`) o de suelo (`x`, `y`: la lámpara de pie o de mesa). Las puertas no van aquí: son objetos EXIT.",
      "required": [
        "id",
        "tipo",
        "modelo"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/claveDeCatalogo"
        },
        "tipo": {
          "$ref": "#/$defs/claveDeCatalogo"
        },
        "modelo": {
          "$ref": "#/$defs/claveDeCatalogo"
        },
        "muro": {
          "enum": [
            "fondo",
            "izquierda",
            "derecha",
            "camara"
          ]
        },
        "pos": {
          "$ref": "#/$defs/entero"
        },
        "x": {
          "$ref": "#/$defs/entero"
        },
        "y": {
          "$ref": "#/$defs/entero"
        },
        "sobre": {
          "type": "integer",
          "minimum": 0,
          "maximum": 528
        },
        "encendida": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "muro",
            "pos"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "x"
                ]
              },
              {
                "required": [
                  "y"
                ]
              },
              {
                "required": [
                  "sobre"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "x",
            "y"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "muro"
                ]
              },
              {
                "required": [
                  "pos"
                ]
              }
            ]
          }
        }
      ]
    },
    "claveDeCatalogo": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(?![\\s\\S])"
    },
    "entero": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
